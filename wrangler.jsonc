{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-garden",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "the-garden",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (never in this file): GARDEN_PASSCODE and SESSION_SECRET,
  // set with `wrangler secret put`. Locally they come from .dev.vars.
}
